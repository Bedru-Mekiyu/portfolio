{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Bedru Mekiyu Portfolio Website",
  "main": "index.html",
  "scripts": {
    "build:tailwind": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --minify",
    "watch:tailwind": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.css --watch",
    "test:links": "python3 scripts/check_links.py",
    "test": "npm run build:tailwind && npm run test:links"
  },
